---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from './SectionHeading.astro';
import SectionDivider from './SectionDivider.astro';
import type { MunProgram } from '../data/munPrograms';

interface Props { program: MunProgram; }
const { program } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const logoUrl = `${base}${program.logo}`;
---

<BaseLayout title={program.title} description={program.summary}>
  <section class="program-hero">
    <div class="container">
      <a class="back-link" href={base}>← Volver a ESCJ CONECTA</a>
      <div class="program-hero-grid">
        <div class="program-hero-copy">
          <span class="eyebrow">Modelos de Naciones Unidas · Comunidad ESCJ</span>
          <h1>{program.title}</h1>
          <p>{program.summary}</p>
          <a class="button official-link" href={program.officialUrl} target="_blank" rel="noreferrer">Visitar sitio oficial <span aria-hidden="true">↗</span></a>
        </div>
        <div class="program-logo"><img src={logoUrl} alt={`Logotipo oficial de ${program.title}`} /></div>
      </div>
    </div>
    <div class="hero-accent" aria-hidden="true"></div>
  </section>

  <SectionDivider />

  <div class="container program-content">
    <section class="content-section">
      <SectionHeading eyebrow="El programa" title={`¿Qué es ${program.title}?`} description={program.whatIsIt} />
      <article class="info-panel">
        <h3>Importancia para la comunidad educativa</h3>
        <p>{program.communityImportance}</p>
      </article>
    </section>

    <section class="content-section edition-section">
      <SectionHeading eyebrow="Historia y ediciones" title="Edición e información disponible" description={program.editionInfo} />
    </section>

    <section class="content-section objectives-section">
      <SectionHeading eyebrow="Participación" title="Objetivos y actividades" description="Información publicada por el colegio y el sitio oficial del programa." />
      <div class="detail-grid">
        <article class="detail-card">
          <h3>Objetivos</h3>
          {program.objectives.length > 0 ? <ul>{program.objectives.map((objective) => <li>{objective}</li>)}</ul> : <p class="unavailable">Los objetivos específicos no están detallados en la información actualmente disponible. Consulta el <a href={program.officialUrl} target="_blank" rel="noreferrer">sitio oficial <span aria-hidden="true">↗</span></a>.</p>}
        </article>
        <article class="detail-card">
          <h3>Actividades</h3>
          {program.activities.length > 0 ? <ul>{program.activities.map((activity) => <li>{activity}</li>)}</ul> : <p class="unavailable">Las actividades específicas no están detalladas en la información actualmente disponible. Consulta el <a href={program.officialUrl} target="_blank" rel="noreferrer">sitio oficial <span aria-hidden="true">↗</span></a>.</p>}
        </article>
      </div>
    </section>

    <section class="content-section gallery-section">
      <SectionHeading eyebrow="Galería" title="Imágenes del programa" description="Fotografías publicadas por el sitio oficial, cuando están disponibles." />
      {program.photos.length > 0 ? (
        <div class="photo-grid">
          {program.photos.map((photo) => (
            <figure class="photo-card">
              <img src={photo.src} alt={photo.alt} loading="lazy" />
              <figcaption>{photo.caption}</figcaption>
            </figure>
          ))}
        </div>
      ) : (
        <div class="unavailable photo-unavailable"><strong>No hay fotografías de ediciones cargadas en el proyecto.</strong><span>Por ahora se presenta el logotipo oficial del programa. Se añadirán imágenes cuando estén disponibles y verificadas.</span></div>
      )}
    </section>

    <section class="official-panel">
      <div><span class="eyebrow">Más información</span><h2>Consulta el sitio oficial de {program.title}</h2></div>
      <a class="button" href={program.officialUrl} target="_blank" rel="noreferrer">Ir al sitio oficial <span aria-hidden="true">↗</span></a>
    </section>
  </div>
</BaseLayout>

<style>
  .program-hero { position: relative; overflow: hidden; padding: 30px 0 58px; background: linear-gradient(120deg, var(--navy), #1e4e91); color: white; }
  .back-link { display: inline-flex; margin-bottom: 32px; color: #e4edf8; font-size: .88rem; font-weight: 700; text-decoration: none; }
  .back-link:hover { color: white; text-decoration: underline; text-decoration-color: var(--red); text-underline-offset: 4px; }
  .program-hero-grid { display: grid; grid-template-columns: 1fr 320px; align-items: center; gap: 50px; }
  .program-hero-copy .eyebrow { color: #f1f5fa; }
  .program-hero-copy h1 { margin: 17px 0 12px; color: white; font: 800 clamp(2.4rem, 5vw, 4rem)/1.08 var(--font-display); letter-spacing: -.055em; }
  .program-hero-copy > p { max-width: 650px; margin: 0; color: #dbe5f1; font-size: 1.06rem; line-height: 1.75; }
  .official-link { margin-top: 24px; border-color: var(--red); background: var(--red); }
  .official-link:hover { border-color: #a9152b; background: #a9152b; }
  .program-logo { display: grid; min-height: 245px; place-items: center; padding: 28px; border: 1px solid #ffffff4d; border-radius: 12px; background: #fff; box-shadow: 0 20px 50px #081b371c; }
  .program-logo img { display: block; width: min(230px, 100%); max-height: 190px; object-fit: contain; }
  .hero-accent { position: absolute; right: 0; bottom: 0; width: min(42%, 420px); height: 6px; background: linear-gradient(90deg, var(--red) 0 58%, white 58% 70%, var(--blue) 70%); }
  .program-content { padding-top: 64px; padding-bottom: 80px; }
  .content-section { padding: 16px 0 48px; }
  .info-panel, .detail-card, .photo-card { border: 1px solid var(--line); border-top: 3px solid var(--blue); border-radius: 9px; background: white; box-shadow: 0 12px 30px #102d5b09; }
  .info-panel { padding: 25px 28px; }
  .info-panel h3, .detail-card h3 { margin: 0 0 10px; color: var(--navy); font: 700 1.12rem var(--font-display); }
  .info-panel p { margin: 0; color: var(--muted); line-height: 1.75; }
  .edition-section { border-top: 1px solid var(--line); }
  .detail-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .detail-card { padding: 24px; }
  .detail-card:nth-child(even), .photo-card:nth-child(even) { border-top-color: var(--red); }
  .detail-card ul { display: grid; gap: 12px; margin: 0; padding-left: 20px; color: var(--muted); line-height: 1.65; }
  .detail-card li::marker { color: var(--red); }
  .unavailable { margin: 0; color: var(--muted); line-height: 1.7; }
  .unavailable a { color: var(--blue); font-weight: 700; }
  .unavailable a:hover { color: var(--red); }
  .photo-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
  .photo-card { overflow: hidden; margin: 0; }
  .photo-card img { display: block; width: 100%; aspect-ratio: 16 / 10; object-fit: cover; background: var(--surface); }
  .photo-card figcaption { padding: 13px 16px; color: var(--muted); font-size: .8rem; }
  .photo-unavailable { display: grid; gap: 6px; padding: 22px; border: 1px dashed #a9b8ca; border-radius: 8px; background: var(--surface); }
  .photo-unavailable strong { color: var(--navy); }
  .official-panel { display: flex; align-items: center; justify-content: space-between; gap: 24px; margin-top: 20px; padding: 28px; border-top: 4px solid var(--red); border-radius: 8px; background: var(--blue-soft); }
  .official-panel .eyebrow { font-size: .67rem; }
  .official-panel h2 { margin: 8px 0 0; color: var(--navy); font: 700 clamp(1.2rem, 2vw, 1.6rem)/1.3 var(--font-display); }
  @media (max-width: 760px) {
    .program-hero-grid { grid-template-columns: 1fr; gap: 28px; }
    .program-logo { min-height: 180px; }
    .program-logo img { max-height: 140px; }
    .detail-grid, .photo-grid { grid-template-columns: 1fr; }
    .official-panel { align-items: flex-start; flex-direction: column; }
  }
</style>
